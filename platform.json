{
  "name": "epic8",
  "title": "Epic8",
  "description": "Open-source 8-bit PIC platform built on the epic-cc whole-program compiler",
  "homepage": "https://github.com/apojomovsky/epic-platformio",
  "license": "MIT",
  "keywords": [
    "dev-platform",
    "pic",
    "microchip",
    "epic-cc",
    "8-bit"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/apojomovsky/epic-platformio.git"
  },
  "version": "0.0.1",
  "engines": {
    "platformio": "^6"
  },
  "packages": {
    "toolchain-epiccc": {
      "type": "toolchain",
      "version": "https://github.com/apojomovsky/epic-platformio/releases/download/toolchain-epiccc-v0.3.0/toolchain-epiccc-linux_x86_64-0.3.0.tar.gz"
    },
    "framework-epichal": {
      "type": "framework",
      "optional": true,
      "version": "https://github.com/apojomovsky/epic-platformio/releases/download/framework-epichal-v0.6.0/framework-epichal-0.6.0.tar.gz"
    },
    "tool-minipro": {
      "type": "tool",
      "optional": true,
      "version": "https://github.com/apojomovsky/epic-tools/releases/download/tool-minipro-v0.7.4/tool-minipro-linux_x86_64-0.7.4.tar.gz"
    },
    "tool-pk2cmd": {
      "type": "tool",
      "optional": true,
      "version": "https://github.com/apojomovsky/epic-tools/releases/download/tool-pk2cmd-v1.27.1/tool-pk2cmd-linux_x86_64-1.27.1.tar.gz"
    },
    "tool-picpro": {
      "type": "tool",
      "optional": true,
      "version": "https://github.com/apojomovsky/epic-tools/releases/download/tool-picpro-v0.4.1/tool-picpro-linux_x86_64-0.4.1.tar.gz"
    }
  },
  "examples": [
    "examples/blink-pic16f877a",
    "examples/blink-pic16f887",
    "examples/blink-pic18f4550",
    "examples/hal-tick-pic16f877a"
  ]
}
