{
  "name": "epic8",
  "title": "Epic8",
  "description": "Open-source 8-bit PIC platform built on the epic-cc whole-program compiler",
  "homepage": "https://github.com/apojomovsky/epic-platformio",
  "license": "MIT",
  "keywords": [
    "dev-platform",
    "pic",
    "microchip",
    "epic-cc",
    "8-bit"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/apojomovsky/epic-platformio.git"
  },
  "version": "0.0.1",
  "engines": {
    "platformio": "^6"
  },
  "packages": {
    "toolchain-epiccc": {
      "type": "toolchain",
      "owner": "apojomovsky",
      "version": "0.4.0"
    },
    "framework-epichal": {
      "type": "framework",
      "optional": true,
      "owner": "apojomovsky",
      "version": "0.6.0"
    },
    "tool-minipro": {
      "type": "tool",
      "optional": true,
      "owner": "apojomovsky",
      "version": "0.7.4"
    },
    "tool-pk2cmd": {
      "type": "tool",
      "optional": true,
      "owner": "apojomovsky",
      "version": "1.27.1"
    }
  },
  "examples": [
    "examples/blink-pic16f877a",
    "examples/blink-pic16f887",
    "examples/blink-pic18f4550",
    "examples/blink-tutorial-pic12f675",
    "examples/blink-tutorial-pic16f1937",
    "examples/blink-tutorial-pic16f628a",
    "examples/blink-tutorial-pic16f877a",
    "examples/blink-tutorial-pic16f887",
    "examples/blink-tutorial-pic18f4550",
    "examples/blink-xc8-pic16f877a",
    "examples/blink-xc8-pic16f887",
    "examples/blink-xc8-pic18f4550",
    "examples/hal-tick-pic16f877a",
    "examples/hal-tick-pic16f887",
    "examples/hal-tick-pic18f4550",
    "examples/hal-tick-xc8-pic16f877a"
  ]
}
