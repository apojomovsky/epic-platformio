{
  "name": "epic8",
  "title": "Epic8",
  "description": "Fully open-source, MIT licensed C for 8-bit PIC under PlatformIO: the epic-cc compiler plus epic-hal, a register-level HAL and drivers, built in.",
  "homepage": "https://github.com/apojomovsky/epic-platformio",
  "license": "MIT",
  "keywords": [
    "dev-platform",
    "pic",
    "microchip",
    "pic12",
    "pic14",
    "pic16",
    "pic18",
    "8-bit",
    "epic-cc",
    "xc8-alternative",
    "sdcc",
    "mplab",
    "pickit",
    "tl866",
    "k150",
    "pic12f675",
    "pic16f1937",
    "pic16f628a",
    "pic16f877a",
    "pic16f887",
    "pic18f4550"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/apojomovsky/epic-platformio.git"
  },
  "version": "0.1.1",
  "engines": {
    "platformio": "^6"
  },
  "frameworks": {
    "epichal": {
      "package": "framework-epichal",
      "script": "builder/frameworks/epichal.py"
    }
  },
  "packages": {
    "toolchain-epiccc": {
      "type": "toolchain",
      "owner": "apojomovsky",
      "version": "0.4.0+pio1"
    },
    "framework-epichal": {
      "type": "framework",
      "optional": true,
      "owner": "apojomovsky",
      "version": "0.6.0+pio1"
    },
    "tool-minipro": {
      "type": "tool",
      "optional": true,
      "owner": "apojomovsky",
      "version": "0.7.4"
    },
    "tool-pk2cmd": {
      "type": "tool",
      "optional": true,
      "owner": "apojomovsky",
      "version": "1.27.1"
    },
    "tool-picpro": {
      "type": "tool",
      "optional": true,
      "owner": "apojomovsky",
      "version": "0.4.1"
    }
  },
  "examples": [
    "examples/hal-tick-pic16f877a",
    "examples/hal-tick-pic16f887",
    "examples/hal-tick-pic18f4550",
    "examples/hal-tick-xc8-pic16f877a",
    "examples/blink-pic16f877a",
    "examples/blink-pic16f887",
    "examples/blink-pic18f4550",
    "examples/blink-tutorial-pic12f675",
    "examples/blink-tutorial-pic16f1937",
    "examples/blink-tutorial-pic16f628a",
    "examples/blink-tutorial-pic16f877a",
    "examples/blink-tutorial-pic16f887",
    "examples/blink-tutorial-pic18f4550",
    "examples/blink-xc8-pic16f877a",
    "examples/blink-xc8-pic16f887",
    "examples/blink-xc8-pic18f4550"
  ]
}
