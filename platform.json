  "repository": {
    "type": "git",
    "url": "https://github.com/apojomovsky/epic-platformio.git"
  },
  "version": "0.1.0",
  "engines": {
    "platformio": "^6"
  },
  "packages": {
    "toolchain-epiccc": {
      "type": "toolchain",
