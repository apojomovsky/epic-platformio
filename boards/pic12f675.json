{
  "build": {
    "framework_epichal_toolchains": [],
    "mcu": "p12f675",
    "oscillator": "internal",
    "toolchains": [
      "epic-cc"
    ]
  },
  "frameworks": [],
  "debug": {
    "default_tools": [
      "epic-sim"
    ],
    "tools": {
      "epic-sim": {
        "init_cmds": [
          "target remote $DEBUG_PORT"
        ],
        "port": ":3333",
        "server": {
          "arguments": [
            "$PROG_DIR/$PROG_NAME.hex",
            "$PROG_PATH",
            "--port",
            "3333"
          ],
          "executable": "epic-cc-gdbserver",
          "package": "toolchain-epiccc",
          "ready_pattern": "waiting for gdb"
        }
      }
    }
  },
  "name": "Microchip PIC12F675",
  "support": "simulator",
  "upload": {
    "devices": {
      "minipro": "PIC12F675",
      "picpro": "12F675",
      "pk2cmd": "PIC12F675"
    },
    "hazards": {
      "bandgap_bits": "13:12",
      "lvp_scheme": "none",
      "osccal_word": "0x3FF",
      "pgm_pin": null
    },
    "maximum_ram_size": 64,
    "maximum_size": 2046,
    "protocol": "minipro"
  },
  "url": "https://www.microchip.com/en-us/product/PIC12F675",
  "vendor": "Microchip"
}
