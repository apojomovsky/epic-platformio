{
  "build": {
    "epichal_family": "pic16f87xa",
    "f_cpu": "4000000L",
    "framework_epichal_toolchains": [
      "epic-cc",
      "xc8"
    ],
    "mcu": "p16f877a",
    "toolchains": [
      "epic-cc",
      "xc8"
    ]
  },
  "debug": {
    "default_tools": [
      "epic-sim"
    ],
    "tools": {
      "epic-sim": {
        "init_cmds": [
          "target remote $DEBUG_PORT"
        ],
        "port": ":3333",
        "server": {
          "arguments": [
            "$PROG_DIR/$PROG_NAME.hex",
            "$PROG_PATH",
            "--port",
            "3333"
          ],
          "executable": "epic-cc-gdbserver",
          "package": "toolchain-epiccc",
          "ready_pattern": "waiting for gdb"
        }
      }
    }
  },
  "frameworks": [
    "epichal"
  ],
  "name": "Microchip PIC16F877A",
  "support": "simulator",
  "upload": {
    "devices": {
      "minipro": "PIC16F877A@DIP40",
      "picpro": "16F877A",
      "pk2cmd": "PIC16F877A"
    },
    "hazards": {
      "bandgap_bits": null,
      "lvp_scheme": "pgm_pin",
      "osccal_word": null,
      "pgm_pin": "RB3"
    },
    "maximum_ram_size": 368,
    "maximum_size": 16384,
    "protocol": "minipro"
  },
  "url": "https://www.microchip.com/en-us/product/PIC16F877A",
  "vendor": "Microchip"
}
