{
  "build": {
    "epichal_family": "pic18fxx5x",
    "f_cpu": "20000000L",
    "framework_epichal_toolchains": [
      "epic-cc",
      "xc8"
    ],
    "mcu": "p18f4550",
    "oscillator": "crystal",
    "toolchains": [
      "epic-cc",
      "xc8"
    ]
  },
  "debug": {
    "default_tools": [
      "epic-sim"
    ],
    "tools": {
      "epic-sim": {
        "init_cmds": [
          "target remote $DEBUG_PORT"
        ],
        "port": ":3333",
        "server": {
          "arguments": [
            "$PROG_DIR/$PROG_NAME.hex",
            "$PROG_PATH",
            "--port",
            "3333",
            "--device",
            "p18f4550"
          ],
          "executable": "epic-cc-gdbserver",
          "package": "toolchain-epiccc",
          "ready_pattern": "waiting for gdb"
        }
      }
    }
  },
  "frameworks": [
    "epichal"
  ],
  "name": "Microchip PIC18F4550",
  "support": "simulator",
  "upload": {
    "devices": {
      "minipro": "PIC18F4550@DIP40",
      "picpro": "18F4550",
      "pk2cmd": "PIC18F4550"
    },
    "hazards": {
      "bandgap_bits": null,
      "lvp_scheme": "pgm_pin",
      "osccal_word": null,
      "pgm_pin": "RB5"
    },
    "maximum_ram_size": 2048,
    "maximum_size": 32768,
    "protocol": "minipro",
    "protocols": [
      "minipro",
      "pk2cmd",
      "picpro",
      "custom"
    ],
    "require_upload_port": false
  },
  "url": "https://www.microchip.com/en-us/product/PIC18F4550",
  "vendor": "Microchip"
}
